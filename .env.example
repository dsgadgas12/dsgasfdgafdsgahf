# Telegram bot credentials — set as secret environment variables in Bot-Hosting.
BOT_TOKEN=
WEBAPP_URL=https://YOUR-APP.apps.bot-hosting.cloud
BOT_USERNAME=

# Numeric Telegram user IDs separated by commas.
ADMIN_TG_IDS=

# Security: generate a random value of at least 48 characters.
JWT_SECRET=
CORS_ORIGINS=https://YOUR-APP.apps.bot-hosting.cloud

# Persistent SQLite path. Ensure the host keeps this directory between restarts.
DATABASE_PATH=backend/data/cloudegift.sqlite3

# Public receiving wallet address for the Tonkeeper transfer flow. Never add a seed phrase or private key.
GRAM_WALLET_ADDRESS=UQD2v-fRnsSr8Jov3dp4hRa7vxZbtJVqJaZKrw0EhpEgo0Os

# Free case subscription task. The bot must be an administrator in this channel.
FREE_CASE_CHANNEL=@CloudeCaseNews
FREE_CASE_CHANNEL_URL=https://t.me/CloudeCaseNews
