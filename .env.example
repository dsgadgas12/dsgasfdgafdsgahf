# Telegram bot
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
WEBAPP_URL=https://your-domain.example

# Admin: comma-separated Telegram numeric IDs (not usernames)
ADMIN_TG_IDS=123456789
VITE_ADMIN_IDS=123456789
VITE_DEMO_ADMIN=false

# Security
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DEV_MODE=false
CORS_ORIGINS=https://your-domain.example

# Database
DATABASE_PATH=/app/backend/data/cloudegift.sqlite3

# Optional domain for Caddy HTTPS
DOMAIN=your-domain.example

# Public wallet for incoming GRAM deposits (do not put seed phrase/private key here)
GRAM_WALLET_ADDRESS=PUT_PUBLIC_WALLET_ADDRESS_HERE
GRAM_JETTON_MASTER_ADDRESS=PUT_GRAM_JETTON_MASTER_ADDRESS_HERE

# Free case tasks: add the bot as an administrator in this channel.
# Public channel: @channel_username. Private channel: numeric -100... ID.
FREE_CASE_CHANNEL=@YOUR_CHANNEL
# Public channel link or invite link for a private channel. Send the real link later and replace this value.
FREE_CASE_CHANNEL_URL=https://t.me/YOUR_CHANNEL
# Optional; if empty, the backend reads the bot username using getMe.
BOT_USERNAME=
